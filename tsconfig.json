{
  "compilerOptions": {
    "module": "commonjs", "moduleResolution": "node", "target": "ES2022",
    "lib": ["ES2022"], "rootDir": "./src", "outDir": "./dist",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "skipLibCheck": true, "sourceMap": true,
    "incremental": false, "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist"]
}
