# Dedicated server stack (compose.server.yaml). Copy to .env.server and fill in. Never commit .env.server.
POSTGRES_USER=radar
POSTGRES_PASSWORD=change_me_to_a_long_random_url_safe_value
POSTGRES_DB=radar
# Tune to the server: ~25% of RAM for shared_buffers, ~70% for effective_cache_size
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
BACKUP_KEEP_DAYS=14

# API (NestJS). 127.0.0.1 = only through the Caddy proxy; 0.0.0.0 = open port 3000 directly.
API_BIND_ADDRESS=127.0.0.1
API_DOMAIN=api.example.com
INGEST_API_KEY=replace_with_a_random_secret_at_least_32_characters
CORS_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_RESEARCH=important

# Knowledge pipeline
KB_LOG_LEVEL=INFO
KB_EMBEDDINGS=true
KB_WIKIDATA=true
# Project mailbox shown to OpenAlex/Crossref/Wikidata in the User-Agent (optional, never a personal address)
CONTACT_EMAIL=
KB_READY_MIN_SOURCES=2
KB_DEEP_MIN_SOURCES=4

# --- Editorial from the knowledge base (tasks 1 and 4) ---
# auto = KB editor while the Python workers run, legacy RSS editor otherwise; kb / rss force one of them
EDITORIAL_SOURCE=auto
# medium news: cheap models, 5 events per request
KB_MEDIUM_DAILY=50
KB_MEDIUM_BATCH=5
KB_MEDIUM_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# big articles: 3.8 Flash writes 3 per request, 3.6 and 3 Flash are the spares; no Lite fallback, events wait for the reset
KB_BIG_DAILY=30
KB_BIG_BATCH=3
KB_BIG_MIN_SOURCES=3
KB_BIG_MIN_FULL_TEXT=3
KB_BIG_MIN_SCORE=0.35
KB_BIG_CALLS_DAILY=20
KB_BIG_URGENT_CALLS=3
KB_URGENT_MIN_SCORE=0.7
KB_BIG_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview
KB_REVIEW_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
KB_FIX_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview
# a few new facts: Gemma adds cited paragraphs to the live article instead of a rewrite
KB_MINOR_UPDATES=true
KB_EDITORIAL_INTERVAL_MS=600000
# flagships: KB dossier + web research (cheap search model, pages fetched by our collector) -> ONE Hydrogen call
KB_FLAGSHIP_DAILY=8
KB_FLAGSHIP_MIN_SOURCES=3
KB_FLAGSHIP_MODELS=gemini-4-hydrogen
KB_FLAGSHIP_PLAN_MODELS=gemini-3-flash-preview
KB_FLAGSHIP_REVIEW_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
KB_RESEARCH_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
KB_FLAGSHIP_SEARCH_CALLS=2
KB_FLAGSHIP_RESEARCH_PAGES=12
KB_FLAGSHIP_RESEARCH_WAIT_MIN=25
KB_FLAGSHIP_INTERVAL_MS=1200000
# new articles go live after the Ukrainian translation (cheap models); true = publish the English text immediately
KB_PUBLISH_BEFORE_TRANSLATION=false
# true = build dossiers and log sizes without calling a model
KB_EDITORIAL_DRY_RUN=false
# --- Shared daily LLM budget (every HTTP attempt counts, all processes) ---
LLM_DAILY_LIMITS=gemini-3.8-flash=20,gemini-3.6-flash=20,gemini-2.5-flash=20,gemini-4-hydrogen=20
# requests kept for one purpose; other features share the rest
LLM_BUDGET_RESERVED=gemini-4-hydrogen=kb_flagship:10,gemini-3.8-flash=kb_big:12,gemini-3.6-flash=kb_fix:10,gemini-2.5-flash=kb_review:12
# Illustrative section/hero/background photos: Pixabay -> Openverse -> Pexels.
pixabay_api_key=
OPENVERSE_ENABLED=true
openverse_access_token=
pexels_api_key=
# R2 photo storage (3 calendar months, hourly expiry cleanup; migration 031).
cloudflare_s3_api_endpoint=
cloudflare_access_key_id=
cloudflare_secret_access_key=
cloudflare_r2_bucket=
# Optional: otherwise photos are served via /api/v1/media/photos/:file.
cloudflare_r2_public_base_url=
# --- Open-data connectors (task 3; container kb-connectors) ---
# keyless: World Bank, Eurostat, ECB, NBU, UNHCR, FAOSTAT, EU sanctions, SEC EDGAR, Nasdaq Trader, GDELT, USAspending, TED, OpenAlex/Crossref
FRED_API_KEY=
EIA_API_KEY=
# ACLED requires an account (respect ACLED terms of use)
ACLED_EMAIL=
ACLED_PASSWORD=
OPENALEX_API_KEY=
KB_ACLED_COUNTRIES=Ukraine,Russia
KB_CONTRACT_KEYWORDS=Ukraine,drone,ammunition,air defense,artillery,energy security,demining
# disable one connector: KB_CONNECTOR_<NAME>=false, e.g. KB_CONNECTOR_TED=false
# Ukrainian data + OECD (keyless: OECD, Держстат, Prozorro, Rada). NASA FIRMS: free MAP_KEY from firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=
# heavy weekly/daily dumps (GBs): opt in with 1
KB_EDR_ENABLED=
KB_COURTS_ENABLED=
KB_COURT_DAYS=14
KB_PROZORRO_MIN_UAH=20000000
# extra buyer EDRPOU codes to follow on Prozorro, comma separated (branches have their own codes)
KB_PROZORRO_BUYERS=
# data.rada.gov.ua may block foreign networks; override the bills CSV if the default path changes
KB_RADA_BILLS_URL=
# --- Video worker (container kb-video) ---
# true: the YouTube radar queues worthy videos for the KB worker instead of calling Gemini itself
KB_VIDEO_WORKER=true
KB_VIDEO_DAILY=30
KB_VIDEO_SPEED=1.2
KB_VIDEO_MAX_PAUSE=0.8
KB_VIDEO_TRANSCRIBE_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
KB_VIDEO_ANALYZE_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
KB_WHISPER_THREADS=4
# YouTube may ask datacenter IPs to sign in; a residential/HTTP proxy for yt-dlp helps (optional)
KB_YTDLP_PROXY=
