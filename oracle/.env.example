# Helper server (Oracle, 1 GB). Copy to .env, chmod 600.
HELPER_DOMAIN=helper.example.com
API_URL=https://api.example.com
RSSHUB_ACCESS_KEY=change_me_long_random
NTFY_TOPIC=news-alerts
CHANGEDETECTION_USER=admin
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your password'
