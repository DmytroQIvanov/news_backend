# optional RSSHub credentials for Telegram/YouTube routes
TELEGRAM_SESSION=
YOUTUBE_API_KEY=
# docker compose exec ntfy ntfy user add --role=admin me ; docker compose exec ntfy ntfy token add me
NTFY_TOKEN=
