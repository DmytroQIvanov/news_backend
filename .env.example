# LOCAL only. Never commit a real .env.
POSTGRES_USER=radar
POSTGRES_PASSWORD=change_me_local_12345
POSTGRES_DB=radar
DATABASE_URL=postgresql://radar:change_me_local_12345@127.0.0.1:5432/radar
DIRECT_URL=postgresql://radar:change_me_local_12345@127.0.0.1:5432/radar
INGEST_API_KEY=replace_with_a_random_secret_at_least_32_characters
PORT=3000
# Publish the Compose API to the local network for Expo Go. Use 127.0.0.1 for PC-only access.
API_BIND_ADDRESS=0.0.0.0
# Set an exact browser origin if using a web client, for example http://localhost:3001.
CORS_ORIGINS=
DB_POOL_MAX=3
NODE_ENV=development
