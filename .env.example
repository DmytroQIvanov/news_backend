# LOCAL only. Never commit a real .env.
POSTGRES_USER=radar
POSTGRES_PASSWORD=change_me_local_12345
POSTGRES_DB=radar
DATABASE_URL=postgresql://radar:change_me_local_12345@127.0.0.1:5432/radar
DIRECT_URL=postgresql://radar:change_me_local_12345@127.0.0.1:5432/radar
INGEST_API_KEY=replace_with_a_random_secret_at_least_32_characters
PORT=3000
# Publish the Compose API to the local network for Expo Go. Use 127.0.0.1 for PC-only access.
API_BIND_ADDRESS=0.0.0.0
# Set an exact browser origin if using a web client, for example http://localhost:3001.
CORS_ORIGINS=
DB_POOL_MAX=3
NODE_ENV=development
# Set these in Render Environment to enable automated editorial processing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# off | important (search only for multi-source/boosted stories) | all (every article; uses much more quota)
GEMINI_RESEARCH=important
# Topic explainers and prediction checks (background job). Set TOPICS_ENABLED=false to stop it.
TOPICS_ENABLED=true
TOPIC_SUMMARY_DAILY_MAX=30
# Optional Apify token (same name as in Render) used sparingly for YouTube transcript fallback (max 5/day)
apify_token=
YOUTUBE_MAX_DAILY_TRANSCRIPTIONS=30
YOUTUBE_MAX_DAILY_APIFY=5

# --- v2.0: Cloudflare R2 (S3) storage + Workers AI caricatures ---
cloudflare_account_id=
cloudflare_api_token=
cloudflare_access_key_id=
cloudflare_secret_access_key=
cloudflare_s3_api_endpoint=
# Optional: bucket name (default: path in the endpoint, else "news-radar") and a public r2.dev/custom domain
cloudflare_r2_bucket=
cloudflare_r2_public_base_url=
CARICATURE_DAILY_MAX=4
STORY_BRIEFING_DAILY_MAX=36
# Optional: Pexels stock API for article hero/ambient backgrounds (200 req/hr, 20k/mo free)
PEXELS_API_KEY=
# Primary illustrative photos: Pixabay -> Openverse (no key required) -> Pexels.
pixabay_api_key=
OPENVERSE_ENABLED=true
# Optional short-lived bearer token for higher Openverse limits; anonymous requests work without it.
openverse_access_token=
# Licensed photos are stored in R2 for exactly 3 calendar months (migration 031).
# R2 credentials above are required for stock photos; no permanent Pixabay hotlinking.
# Optional: fixes empty memes (Reddit blocks anonymous cloud IPs; Bluesky may require login)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Optional: YouTube Data API key to find related videos for big stories (max 40 searches/day)
YOUTUBE_API_KEY=
# YouTube channel discovery by Gemini (daily). Min subscribers applies only when YOUTUBE_API_KEY is set.
YOUTUBE_CHANNEL_DISCOVERY=true
YOUTUBE_CHANNEL_MIN_SUBSCRIBERS=20000

# --- v2.1: AI providers (free tiers). Router roles: Gemini = editor/search/TTS, Groq = fast translations/captions/fact-check + editorial fallback, OpenRouter = deep stories + last fallback
groq_api_key=
openrouter_api_key=
# Optional overrides
GROQ_MODEL_SMART=openai/gpt-oss-120b
GROQ_MODEL_FAST=qwen/qwen3.8-27b
OPENROUTER_MODEL=openrouter/free
# 50/day without purchased credits, 1000/day after buying 10 credits once
OPENROUTER_DAILY_LIMIT=50
# Per-task provider order, e.g. LLM_CHAIN_STORY=openrouter,gemini,groq
# --- v2.1: audio in R2 (English canonical, then translations) ---
AUDIO_LANGS=en,uk
TTS_STORAGE_MAX_BYTES=1073741824
TTS_PROVIDER_ORDER=gemini,groq_tts,workers_ai,google_tts
# Optional Ukrainian-capable backup voice (Google Cloud Text-to-Speech free monthly allowance)
GOOGLE_TTS_API_KEY=
# Future languages translated from English, e.g. pl,de,es
APP_EXTRA_LANGS=
# --- Insights: scripted link analysis (migration 024) ---
# Runs every INSIGHTS_INTERVAL_MS (default 1 hour). Set INSIGHTS_ENABLED=false to stop it.
INSIGHTS_ENABLED=true
INSIGHTS_INTERVAL_MS=3600000
# Analysis window and "new" window, in days
INSIGHTS_WINDOW_DAYS=180
INSIGHTS_RECENT_DAYS=14
# true = also count news still in needs_review (public endpoints still show only published evidence)
INSIGHTS_INCLUDE_UNREVIEWED=false
# AI is optional: candidate classification + short explanations. Total AI calls per day for insights.
INSIGHTS_AI_DAILY_MAX=12
INSIGHTS_EXPLAIN_PER_RUN=3
# A new name becomes a candidate after this many articles from this many sources
INSIGHTS_CANDIDATE_MIN_MENTIONS=3
INSIGHTS_CANDIDATE_MIN_SOURCES=2
# Without AI: auto-accept candidates seen in at least N articles from 3+ sources (0 = off, review manually)
INSIGHTS_AUTO_ACCEPT_MIN_MENTIONS=0

# --- v2.2: open data, news photos, charts, memes, caricatures (all optional, free) ---
# Contact sent to OpenAlex/Crossref "polite pool" (your project mailbox, never a personal one)
CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
# LLM data-extraction pass that builds charts/tables from article text (max requests per day)
NEWS_VISUALS_DAILY_MAX=30
NEWS_VISUALS_ENABLED=true
NEWS_MEDIA_ENABLED=true
# Caricatures work without Cloudflare: Pollinations (keyless) + Postgres storage fallback
POLLINATIONS_ENABLED=true
CARICATURE_IMAGE_PROVIDERS=workers_ai,pollinations
# Original AI memes on public Imgflip templates when no real public memes exist
AI_MEMES_ENABLED=true
# --- Long-form articles (big stories: 2+ sources or important) ---
# Body is planned and written section by section (4-7 sections), then translated in chunks: ~8-14 AI calls per article
EDITORIAL_SECTIONED=true
EDITORIAL_SECTIONED_DAILY_MAX=40
# Articles turned into full AI text per 5-minute cycle (more = faster, uses more free quota)
EDITORIAL_MAX_PER_CYCLE=6
# Bodies shorter than this get expanded (default 220 words, 380 for multi-source stories)
EDITORIAL_MIN_BODY_WORDS=
# --- Knowledge-base editorial and shared LLM budget (see .env.server.example for all options) ---
EDITORIAL_SOURCE=auto
LLM_DAILY_LIMITS=gemini-3.8-flash=20,gemini-3.6-flash=20,gemini-2.5-flash=20,gemini-4-hydrogen=20
