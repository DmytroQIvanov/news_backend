{
  "name": "opportunity-radar-api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/ingest/editorial-prompt.md','dist/ingest/editorial-prompt.md')\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node scripts/migrate.cjs && node dist/main.js",
    "migrate": "node scripts/migrate.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "preflight": "node scripts/preflight.cjs",
    "test": "npm run build && node --test tests/backend.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.2",
    "typescript": "^5.8.3"
  }
}
